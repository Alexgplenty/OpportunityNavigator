@page "/opportunity/{AccountIdentifier}"
@rendermode InteractiveServer

@using OpportunityNavigator.Models
@using OpportunityNavigator.Services

@inject OpportunityService OpportunityService
@inject OpportunityPromptService PromptService
@inject OpenAIService OpenAIService

<h1>Opportunity Profile</h1>

@if (opportunity == null)
{
    <p>Loading...</p>
}
else
{
    <h3>@opportunity.AccountIdentifier</h3>
    <h3>@opportunity.AccountName</h3>
    <h3>@opportunity.Country</h3>


    <p><strong>Intent Overall Score:</strong> @opportunity.IntentScore</p>

    <p><strong>Total Site Visits:</strong> @opportunity.TotalVisits</p>

    <p><strong>Knowledge Page Visits:</strong> @opportunity.KnowledgeVisits</p>

    <p><strong>AI Page Visits:</strong> @opportunity.AIVisits</p>

    <p><strong>Product Page Visits:</strong> @opportunity.ProductVisits</p>

    <p><strong>Sales Page Visits:</strong> @opportunity.SalesVisits</p>

    <p><strong>Corporate Page Visits:</strong> @opportunity.CorporateVisits</p>

    <p><strong>Partner Page Visits:</strong> @opportunity.PartnerVisits</p>

    <p><strong>Legal Page Visits:</strong> @opportunity.LegalVisits</p>

    <p><strong>CareerPage Visits:</strong> @opportunity.CareerVisits</p>

    <hr />

    <button class="btn btn-primary"
            @onclick="GenerateOpportunityBrief">
        Generate AI Opportunity Brief
    </button>

    @if (!string.IsNullOrEmpty(brief))
    {
        <hr />

        <h3>AI Brief</h3>

        <div class="border rounded p-3 bg-light">
        <pre style="white-space: pre-wrap;">@brief</pre>
        </div>
    }
}
@code {

    [Parameter]
    public string AccountIdentifier { get; set; } = "";

    private OpportunityProfile? opportunity;

    private string brief = "";

    protected override async Task OnInitializedAsync()
    {
        opportunity =
            await OpportunityService.GetOpportunityAsync(
                AccountIdentifier);
    }

    private async Task GenerateOpportunityBrief()
    {
        if (opportunity != null)
        {
            var prompt =
                PromptService.GenerateOpportunityBrief(
                    opportunity);

            brief =
                await OpenAIService.GenerateOpportunityBrief(
                    prompt);
        }
    }

}