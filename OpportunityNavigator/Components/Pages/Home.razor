@page "/"
@inject CsvOpportunityService CsvOpportunityService
@using OpportunityNavigator.Services
<h1>Sales Team HOME PAGE</h1>

<a href="/opportunities">
Opportunity Navigator
</a>

<p>CSV Rows: @rowCount</p>

@code
{
    private int rowCount;

    protected override async Task OnInitializedAsync()
    {
        rowCount =
            await CsvOpportunityService.CountRowsAsync();
    }
}