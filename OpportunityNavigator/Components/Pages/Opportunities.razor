@page "/opportunities"

@using OpportunityNavigator.Models
@using OpportunityNavigator.Services

@inject CsvOpportunityService CsvOpportunityService

<h1>Top Sales Oportunities</h1>
<button class="btn btn-secondary"
        onclick="history.back()">
    Back
</button>

@if (opportunities == null)
{
    <p>Loading...</p>
}
else
{
   <table class="table">

    <thead>
        <tr>
            <th>Account Identifier</th>
            <th>Account Name</th>
            <th>Purchase Intent Score</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var opportunity in opportunities)
        {
            <tr>
                <td>
                    <a href="/opportunity/@opportunity.AccountIdentifier">
                        @opportunity.AccountIdentifier
                    </a>
                </td>
                <td>
                    @opportunity.AccountName
                </td>
                <td>
                    @opportunity.IntentScore
                </td>
            </tr>
        }
    </tbody>

</table>
}

@code
{
    private List<OpportunityProfile>? opportunities;

    protected override async Task OnInitializedAsync()
    {
        opportunities = await CsvOpportunityService.GetTopOpportunitiesAsync();
    }
}