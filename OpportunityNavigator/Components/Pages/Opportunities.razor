@page "/opportunities"
@rendermode InteractiveServer
@using OpportunityNavigator.Models
@using OpportunityNavigator.Services

@inject CsvOpportunityService CsvOpportunityService

<h1>Top Sales Opportunities</h1>

<button class="btn btn-secondary"
        onclick="history.back()">
    Back
</button>

@if (opportunities == null)
{
    <p>Loading...</p>
}
else
{
    <div class="mt-3 mb-3">

        <input class="form-control"
               placeholder="Search by account, IP address, country or industry"
               @bind="searchText"
               @bind:event="oninput" />

    </div>

    <p>
        Showing @FilteredOpportunities.Count() of @opportunities.Count opportunities
    </p>
<p>
    Search Text: @searchText
</p>
    <table class="table">

        <thead>
            <tr>
                <th>Account Identifier</th>
                <th>Account Name</th>
                <th>Country</th>
                <th>Industry</th>
                <th>Purchase Intent Score</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var opportunity in FilteredOpportunities)
            {
                <tr>
                   <td>
                   <a href="/opportunity/@opportunity.AccountIdentifier">
                        @opportunity.AccountIdentifier
                    </a>
                    </td>
                    <td>
                        @opportunity.AccountName
                    </td>

                    <td>
                        @opportunity.Country
                    </td>

                    <td>
                        @opportunity.Industry
                    </td>

                    <td>
                        @opportunity.IntentScore
                    </td>
                </tr>
            }
        </tbody>

    </table>
}

@code
{
    private List<OpportunityProfile>? opportunities;

    private string searchText = "";

    private IEnumerable<OpportunityProfile> FilteredOpportunities =>
        opportunities == null
            ? Enumerable.Empty<OpportunityProfile>()
            : opportunities.Where(o =>
                string.IsNullOrWhiteSpace(searchText)
                || o.AccountIdentifier.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                || o.AccountName.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                || o.Country.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                || o.Industry.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(o => o.IntentScore);

    protected override async Task OnInitializedAsync()
    {
        opportunities =
            await CsvOpportunityService.GetTopOpportunitiesAsync();
    }
}